# OpenSSL configuration for Intermediate CA
# Security: ECDSA P-384, issues short-lived client certificates

[ca]
default_ca = CA_default

[CA_default]
dir               = .
certs             = $dir
crl_dir           = $dir
new_certs_dir     = $dir
database          = $dir/index.txt
serial            = $dir/serial
RANDFILE          = $dir/.rand

private_key       = $dir/intermediate.key
certificate       = $dir/intermediate.crt

crlnumber         = $dir/crlnumber
crl               = $dir/intermediate.crl
crl_extensions    = crl_ext
default_crl_days  = 7

default_md        = sha384
name_opt          = ca_default
cert_opt          = ca_default
default_days      = 1
preserve          = no
policy            = policy_loose

[policy_loose]
countryName             = optional
stateOrProvinceName     = optional
localityName            = optional
organizationName        = supplied
organizationalUnitName  = optional
commonName              = supplied
emailAddress            = optional

[req]
default_bits        = 384
distinguished_name  = req_distinguished_name
string_mask         = utf8only
default_md          = sha384
prompt              = no

[req_distinguished_name]
countryName                     = BE
stateOrProvinceName             = Brussels
localityName                    = Brussels
organizationName                = MediVault PKI
organizationalUnitName          = Intermediate CA
commonName                      = MediVault Intermediate CA

[v3_intermediate_ca]
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints = critical, CA:true, pathlen:0
keyUsage = critical, digitalSignature, cRLSign, keyCertSign

[doctor_cert]
# Extensions for doctor (client) certificates
basicConstraints = CA:FALSE
nsCertType = client
nsComment = "MediVault Doctor Certificate"
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
keyUsage = critical, nonRepudiation, digitalSignature
extendedKeyUsage = clientAuth

[crl_ext]
authorityKeyIdentifier=keyid:always
